# Database
DATABASE_URL="postgresql://pesa:pesa@localhost:5434/pesa_match?schema=public"

# App
NODE_ENV="development"
PORT=3001
API_PREFIX="api/v1"

# Auth
JWT_ACCESS_SECRET="replace-with-strong-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"
REFRESH_COOKIE_NAME="pesa_refresh"
REFRESH_COOKIE_SECURE="false"
REFRESH_COOKIE_SAMESITE="lax"

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:3000"

# Frontend (public)
# (none required server-side)
